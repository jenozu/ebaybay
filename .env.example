# Application
FLASK_ENV=production
SECRET_KEY=replace_with_a_long_random_secret
APP_USERNAME=admin
APP_PASSWORD_HASH=replace_with_output_from_scripts/hash_password.py
SESSION_COOKIE_SECURE=true
DATABASE_URL=sqlite:////app/data/app.db
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_BYTES=20971520

# AI (Phase 2)
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=
AI_API_BASE=https://api.openai.com/v1
AI_TIMEOUT_SECONDS=90

# eBay
EBAY_ENVIRONMENT=sandbox
EBAY_MARKETPLACE_ID=EBAY_CA
EBAY_CURRENCY=CAD
EBAY_API_BASE=
EBAY_HTTP_TIMEOUT_SECONDS=30
EBAY_MEDIA_MAX_RETRIES=3
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_DEV_ID=
EBAY_RUNAME=
EBAY_ACCEPT_URL=https://ebaybay.andel-vps.space/oauth/callback
EBAY_DECLINED_URL=https://ebaybay.andel-vps.space/oauth/declined
EBAY_TOKEN_PATH=/app/data/token.json
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EBAY_TOKEN_ENCRYPTION_KEY=
EBAY_OAUTH_REFRESH_MARGIN_SECONDS=300

# Seller defaults (Phase 9)
EBAY_PAYMENT_POLICY_ID=
EBAY_FULFILLMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=
EBAY_MERCHANT_LOCATION_KEY=

# Listing defaults
DEFAULT_CURRENCY=CAD
DEFAULT_QUANTITY=1
DEFAULT_LISTING_FORMAT=FIXED_PRICE
